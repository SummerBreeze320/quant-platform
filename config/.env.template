# =========================================================================
# QuantCopliot Configuration
# Copy to .env and fill in your values
# =========================================================================

# ---- PostgreSQL ----
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=quant_pass_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quant_db

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---- Qlib ----
QLIB_DATA_DIR=data/qlib_data

# ---- RD-Agent LLM Backend (LiteLLM) ----
# Required for rdagent to call LLM for hypothesis generation and code synthesis.
# Supported: OpenAI, Azure, DeepSeek, or any LiteLLM-compatible provider.
CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=your-api-key-here
# OPENAI_API_BASE=https://api.openai.com/v1

# ---- Azure OpenAI (alternative) ----
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=2024-06-01
# CHAT_MODEL=azure/your-deployment-name

# ---- DeepSeek (alternative, cheaper) ----
# CHAT_MODEL=deepseek/deepseek-chat
# DEEPSEEK_API_KEY=

# ---- RD-Agent Qlib Factor Periods ----
QLIB_FACTOR_TRAIN_START=2020-01-01
QLIB_FACTOR_TRAIN_END=2023-12-31
QLIB_FACTOR_VALID_START=2024-01-01
QLIB_FACTOR_VALID_END=2024-12-31
QLIB_FACTOR_TEST_START=2025-01-01
QLIB_FACTOR_TEST_END=2025-12-31

# ---- RD-Agent Workspace ----
# RD-Agent stores session checkpoints and factor code here:
# WORKSPACE_PATH defaults to git_ignore_folder/RD-Agent_workspace

# ---- RD-Agent Loop Control ----
QLIB_FACTOR_EVOLVING_N=10
